# Copy to .env and change every secret.
POSTGRES_USER=bar
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=bar

# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# true when the app is served over HTTPS (or opened only via http://localhost).
# Set to false ONLY for plain-HTTP access on the bar's local network (http://192.168.x.x),
# otherwise browsers drop the refresh cookie and tablets get logged out every 15 minutes.
COOKIE_SECURE=true

# First administrator, created on first start if no users exist. Remove the password afterwards.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

HTTP_PORT=8080

# true to install pytest into the backend image (development / CI)
INSTALL_DEV=false

# Daily database dump into ./backups (see README, "Backups"). Time is in TZ.
TZ=UTC
BACKUP_AT=04:00
BACKUP_KEEP_DAYS=14
